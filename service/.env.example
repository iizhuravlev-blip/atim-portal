# Центральная страница «АТИМ Управление» — upr.atimlab.ru
BASE_URL=https://upr.atimlab.ru
COOKIE_SECURE=1
SECRET_KEY=
# Единый вход через СЭД: секрет portal из SSO_CLIENTS СЭД
AUTH_MODE=sed
SSO_SECRET=
# СЭД: адрес для браузера и внутри Docker, токен модуля portal из DIRECTORY_TOKENS СЭД
SED_URL=https://docs.atimlab.ru
SED_API_URL=http://atim-docs:8000
SED_TOKEN=
# CRM: PORTAL_TOKEN из .env CRM
CRM_URL=https://mind.atimlab.ru
CRM_API_URL=http://atim-crm:8000
CRM_TOKEN=
# Групповой бот — пусто, пока у бота нет /api/v1/widget
BOT_API_URL=
BOT_TOKEN=
TENDER_URL=https://tender.atimlab.ru
